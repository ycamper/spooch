[Unit]
Description=Spooch sharing service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=spooch
Group=spooch
EnvironmentFile=/etc/spooch/spooch.env
ExecStart=/opt/spooch/bin/spoochd
Restart=on-failure
RestartSec=5

# Sandboxing: it writes nothing locally; images live in the bucket.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
UMask=0077
MemoryMax=200M

[Install]
WantedBy=multi-user.target
