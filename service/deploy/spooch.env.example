# /etc/spooch/spooch.env (root:spooch, 0640). install.sh makes it from this
# file once and never overwrites it; fill in the bucket's keys there.
SPOOCH_DATABASE_URL=postgres:///spooch?host=/var/run/postgresql
SPOOCH_ADDR=127.0.0.1:8081
# Links (the viewer page and the image) are on img.; the app talks to api.
# nginx sends both names to this one service.
SPOOCH_PUBLIC_URL=https://img.spooch.app
SPOOCH_S3_ENDPOINT=nyc3.digitaloceanspaces.com
SPOOCH_S3_REGION=nyc3
SPOOCH_S3_BUCKET=spooch-data
SPOOCH_S3_KEY=
SPOOCH_S3_SECRET=
# Creating an account in the app takes this code; leave it empty to keep
# sign-ups closed. Give it only to people you want on the service.
SPOOCH_SIGNUP_CODE=
# How many GB of synced captures each account may keep.
SPOOCH_QUOTA_GB=10
